# Server-side only. Copy to .env.local and fill in.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
APP_PASSWORD=
# Optional overrides
COACH_MODEL=claude-sonnet-5
OPENAI_COACH_MODEL=gpt-4o-mini
DEEPGRAM_AURA_MODEL=aura-2-thalia-en
# Internal beta feedback link. When unset, no feedback link renders anywhere.
# Client-exposed by design (NEXT_PUBLIC_) — it is only a form URL.
NEXT_PUBLIC_FEEDBACK_URL=
